# Copy to .env.local. This proxy setting is used only by the development server.
SUB2API_DEV_TARGET=http://127.0.0.1:8000
# Keep the original Sub2API API contract. Prefer a same-origin production proxy.
VITE_API_BASE_URL=/api/v1
# Optional original Sub2API web console (new tab; separate origin may require sign-in).
# During local development the default is SUB2API_DEV_TARGET.
VITE_OFFICIAL_CONSOLE_URL=
